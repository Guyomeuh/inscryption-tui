@startuml diagramme_classes

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

skinparam nodesep 30
skinparam ranksep 40
skinparam padding 2
skinparam packageStyle rectangle
skinparam linetype ortho

package "models.cards" {

    interface Card {
        + getName() : String
        + getHp() : Integer
        + getDamaged(damages: Integer)
        + getModif() : String
        + isSacrifiable() : Boolean
    }

    interface AliveCard {
        + getBloodCost() : Integer
        + getBoneCost() : Integer
        + getAttack() : Integer
        + attack(opponent: Card
    }

    abstract class BaseCard {
        - m_name : String
        - m_hp : Integer
        + BaseCard(name: String, hp: Integer)
        + getName() : String
        + getHp() : Integer
        + getDamaged(damages: Integer)
        + getModif() : String
        + toString() : String
    }

    class AnimalCard {
        - m_attack : Integer
        - m_bloodCost : Integer
        - m_boneCost : Integer
        + AnimalCard(name: String, hp: Integer, attack: Integer, blood: Integer, bone: Integer)
        + getAttack() : Integer
        + getBloodCost() : Integer
        + getBoneCost() : Integer
        + attack(opponent: Card)
        + isSacrifiable() : Boolean
        + toString() : String
    }

    class ObjectCard {
        + ObjectCard(name: String, hp: Integer)
        + isSacrifiable() : Boolean
    }

    class AliveCardFactory {
        + {static} Chat() : AliveCard
        + {static} Grizzly() : AliveCard
        + {static} Coyote() : AliveCard
        + {static} Moineau() : AliveCard
        + {static} Corbeau() : AliveCard
        + {static} Ecureuil() : AliveCard
        + {static} Hermine() : AliveCard
        + {static} Louveteau() : AliveCard
        + {static} Loup() : AliveCard
        + {static} Punaise() : AliveCard
        + {static} Elan() : AliveCard
        + {static} Vipere() : AliveCard
        + {static} PorcEpic() : AliveCard
    }

    class ObjectCardFactory {
        + {static} Rocher() : Card
        + {static} Sapin() : Card
    }
}

package "models.cards.decorators" {
    abstract class AnimalDecorator {
        - m_card : AliveCard
        + AnimalDecorator(card: AliveCard)
        + getName() : String
        + getHp() : Integer
        + getDamaged(damages: Integer)
        + getBloodCost() : Integer
        + getBoneCost() : Integer
        + getAttack() : Integer
        + attack(opponent: Card)
        + isSacrifiable() : Boolean
        + toString() : String
    }

    abstract class ObjectDecorator {
        - m_card : Card
        + ObjectDecorator(card: Card)
        + toString() : String
    }

    class AirborneAnimal {
        + AirborneAnimal(card: AliveCard)
        + getModif() : String
        + toString() : String
    }

    class FledglingAnimal {
        + FledglingAnimal(card: AliveCard)
        + getModif() : String
        + toString() : String
    }

    class ManyLivesAnimal {
        + ManyLivesAnimal(card: AliveCard)
        + getModif() : String
        + toString() : String
    }

    class SharpQuillsAnimal {
        + {static} COUNTER_ATTACK : Integer = 1
        + SharpQuillsAnimal(card: AliveCard)
        + getModif() : String
        + toString() : String
    }

    class SprinterAnimal {
        + SprinterAnimal(card: AliveCard)
        + getModif() : String
        + toString() : String
    }

    class StinkyAnimal {
        + StinkyAnimal(card: AliveCard)
        + getDamaged(damages: Integer)
        + getModif() : String
        + toString() : String
    }

    class TouchOfDeathAnimal {
        + TouchOfDeathAnimal(card: AliveCard)
        + getModif() : String
        + attack(opponent: Card)
        + toString() : String
    }
}

package "models.gameplay" {

    interface Playable {
        + getDamaged(position: Integer, damages: Integer) : Boolean
        + endTurn() : Integer[4]
        + place(position: Integer, cardIndex: Integer) : Boolean
    }

    interface MatchStrategy {
        + initBot() : Bot
        + botAction(turnNumber: Integer, bot: Bot)
        + initPlayerBoard() : Board
    }

    class Board {
        # {static} SIZE : Integer = 4
        # m_cards : ArrayList<Optional<Card>>
        + Board()
        # validatePosition(position: Integer)
        + isOccupied(position: Integer) : Boolean
        + set(position: Integer, card: Card)
        + moveRight(position: Integer) : Boolean
        + moveLeft(position: Integer) : Boolean
        + getName(position: Integer) : String
        + getHp(position: Integer) : Integer
        + getModif(position: Integer) : String
        + remove(position: Integer) : Optional<Card>
        + sacrifice(position: Integer) : Integer
        + getBlood(position: Integer) : Integer
        + isSacrifiable(position: Integer) : Boolean
        + getAttack(position: Integer) : Integer
        + getDamaged(position: Integer, damages: Integer) : Boolean
        + isAirborne(position: Integer) : Boolean
        + isSprinter(position: Integer) : Boolean
        + toString() : String
    }

    class Player {
        - m_deck : ArrayList<AliveCard>
        - m_hand : ArrayList<AliveCard>
        - m_blood : Integer
        - m_bone : Integer
        - m_observer : ArrayList<PlayerObserver>
        - m_board : Board
        + Player(deck: ArrayList<AliveCard>, board: Board, observer: PlayerObserver)
        + updateAll()
        + reinitPlayer(originalDeck: ArrayList<AliveCard>) : void
        + setNewBoard(board: Board)
        + initHand()
        + getBlood() : Integer
        + getBone() : Integer
        + isAirborne(position: Integer) : Boolean
        + isSprinter(position: Integer) : Boolean
        + sacrifice(position: Integer) : Integer
        + getDeckSize() : Integer
        + getHandSize() : Integer
        + draw() : Boolean
        + availableBlood() : Integer
        + getBloodCost(cardIndex: Integer) : Integer
        + getBoneCost(cardIndex: Integer) : Integer
        + addToDeck(card: AliveCard)
        + place(position: Integer, cardIndex: Integer) : Boolean
        + getDamaged(position: Integer, damages: Integer) : Boolean
        + endTurn() : Integer[4]
        + toString() : String
    }

    class Bot {
        - m_waitingBoard : Board
        - m_board : Board
        - m_cards : ArrayList<AliveCard>
        - m_observer : ArrayList<BotObserver>
        + Bot(board: Board, waitingBoard: Board, cards: ArrayList<AliveCard>, observer: BotObserver)
        + Bot(board: Board, waitingBoard: Board, cards: ArrayList<AliveCard>)
        + updateAll()
        + getCardsSize() : Integer
        + transferCards()
        + isAirborne(position: Integer) : Boolean
        + isSprinter(position: Integer) : Boolean
        + getDamaged(position: Integer, damages: Integer) : Boolean
        + endTurn() : Integer[4]
        + place(position: Integer, cardIndex: Integer) : Boolean
        + addObserver(observer: BotObserver)
        + toString() : String
    }

    class Combat {
        - m_player : Player
        - m_bot : Bot
        - m_currentPlayer : Playable
        - m_strategy : MatchStrategy
        - m_turn : Integer
        - m_balance : Integer
        + Combat(player: Player, strategy: MatchStrategy, botObserver: BotObserver)
        + botTurn()
        + draw() : Boolean
        + place(position: Integer, numCard: Integer) : Boolean
        + availableBlood() : Integer
        + sacrifice(position: Integer) : Integer
        + endTurn() : Boolean
        + getTurn() : Integer
        + getBalance() : Integer
        + checkVictory() : Integer
    }

    class Game {
        - m_gameNumber : Integer
        - m_player : Player
        - m_originalDeck : ArrayList<AliveCard>
        - m_combat : Combat
        - m_observer : ArrayList<GameObserver>
        - m_botObserver : BotObserver
        + Game(player: Player, deck: ArrayList<AliveCard>, gameObs: GameObserver, botObs: BotObserver)
        + botTurn()
        + setStrategy(strategy: MatchStrategy)
        + updateAll()
        + nextCombat()
        + addNewCard(cardName: String)
        + getGameNumber() : Integer
        + endTurn() : Boolean
        + reinitPlayer()
        + getBloodCost(cardIndex: Integer) : Integer
        + getBoneCost(cardIndex: Integer) : Integer
        + getPlayerBone() : Integer
        + sacrifice(position: Integer) : Integer
        + place(position: Integer, numCard: Integer) : Boolean
        + getHandSize() : Integer
        + getDeckSize() : Integer
        + availableBlood() : Integer
        + draw() : Boolean
        + addObserver(observer: GameObserver)
        + checkVictory() : Integer
    }

    class FirstMatch {
        + FirstMatch()
        + initBot() : Bot
        + botAction(turnNumber: Integer, bot: Bot)
        + initPlayerBoard() : Board
    }

    class SecondMatch {
        + SecondMatch()
        + initBot() : Bot
        + botAction(turnNumber: Integer, bot: Bot)
        + initPlayerBoard() : Board
    }

    class ThirdMatch {
        + ThirdMatch()
        + initBot() : Bot
        + botAction(turnNumber: Integer, bot: Bot)
        + initPlayerBoard() : Board
    }
}

package "models.observer" {

    interface GameObserver {
        + updateTurn(turnNumber: Integer)
        + updateBalance(balance: Integer)
        + updateGameNumber(gameNumber: Integer)
    }

    interface PlayerObserver {
        + updatePlayerDeckCount(cardsAmount: Integer)
        + updatePlayerHand(hand: ArrayList<String>)
        + updatePlayerBoardStatus(boardStatus: Boolean[4])
        + updatePlayerBoardHp(boardHp: Integer[4])
        + updatePlayerBoardAtt(boardAtt: Integer[4])
        + updatePlayerBoardModif(boardModif: String[4])
        + updatePlayerBoardName(boardName: String[4])
        + getPlayerBoardStatus(index: Integer) : Boolean
        + getPlayerBoardHp(index: Integer) : Integer
        + getPlayerBoardAtt(index: Integer) : Integer
        + getPlayerBoardModif(index: Integer) : String
        + getPlayerHandCard(index: Integer) : String
        + getPlayerDeckCount() : Integer
        + getPlayerBoardName(index: Integer) : String
        + getPlayerHandSize() : Integer
    }

    interface BotObserver {
        + updateBotWaitingBoardStatus(nextBoardStatus: Boolean[4])
        + updateBotWaitingBoardHp(nextBoardHp: Integer[4])
        + updateBotWaitingBoardAtt(nextBoardAtt: Integer[4])
        + updateBotWaitingBoardModif(nextBoardModif: String[4])
        + updateBotWaitingBoardName(nextBoardName: String[4])
        + updateBotBoardStatus(boardStatus: Boolean[4])
        + updateBotBoardHp(boardHp: Integer[4])
        + updateBotBoardAtt(boardAtt: Integer[4])
        + updateBotBoardModif(boardModif: String[4])
        + updateBotBoardName(boardName: String[4])
        + getBotWaitingBoardStatus(index: Integer) : Boolean
        + getBotWaitingBoardHp(index: Integer) : Integer
        + getBotWaitingBoardAtt(index: Integer) : Integer
        + getBotWaitingBoardModif(index: Integer) : String
        + getBotWaitingBoardName(index: Integer) : String
        + getBotBoardStatus(index: Integer) : Boolean
        + getBotBoardHp(index: Integer) : Integer
        + getBotBoardAtt(index: Integer) : Integer
        + getBotBoardModif(index: Integer) : String
        + getBotBoardName(index: Integer) : String
    }
}

package "view" {

    class GameTextObserver {
        - m_turn : Integer
        - m_balance : Integer
        - m_gameNumber : Integer
        + GameTextObserver()
        + updateTurn(turnNumber: Integer)
        + updateBalance(balance: Integer)
        + updateGameNumber(gameNumber: Integer)
        + getGameNumber() : String
        + getBalance() : String
        + getTurn() : String
    }

    class PlayerTextObserver {
        - m_deckCardAmount : Integer
        - m_playerHand : ArrayList<String>
        - m_playerBoardStatus : Boolean[4]
        - m_playerBoardHp : Integer[4]
        - m_playerBoardAtt : Integer[4]
        - m_playerBoardModif : String[4]
        - m_playerBoardName : String[4]
        + PlayerTextObserver()
        + updatePlayerDeckCount(cardsAmount: Integer)
        + updatePlayerHand(hand: ArrayList<String>)
        + updatePlayerBoardStatus(boardStatus: Boolean[4])
        + updatePlayerBoardHp(boardHp: Integer[4])
        + updatePlayerBoardAtt(boardAtt: Integer[4])
        + updatePlayerBoardModif(boardModif: String[4])
        + updatePlayerBoardName(boardName: String[4])
        + getPlayerBoardStatus(index: Integer) : Boolean
        + getPlayerBoardHp(index: Integer) : Integer
        + getPlayerBoardAtt(index: Integer) : Integer
        + getPlayerBoardModif(index: Integer) : String
        + getPlayerHandCard(index: Integer) : String
        + getPlayerHandSize() : Integer
        + getPlayerDeckCount() : Integer
        + getPlayerBoardName(index: Integer) : String
    }

    class BotTextObserver {
        - m_waitingBoardStatus : Boolean[4]
        - m_waitingBoardHp : Integer[4]
        - m_waitingBoardAtt : Integer[4]
        - m_waitingBoardModif : String[4]
        - m_waitingBoardName : String[4]
        - m_boardStatus : Boolean[4]
        - m_boardHp : Integer[4]
        - m_boardAtt : Integer[4]
        - m_boardModif : String[4]
        - m_boardName : String[4]
        + BotTextObserver()
        + updateBotWaitingBoardStatus(nextBoardStatus: Boolean[4])
        + updateBotWaitingBoardHp(nextBoardHp: Integer[4])
        + updateBotWaitingBoardAtt(nextBoardAtt: Integer[4])
        + updateBotWaitingBoardModif(nextBoardModif: String[4])
        + updateBotWaitingBoardName(nextBoardName: String[4])
        + updateBotBoardStatus(boardStatus: Boolean[4])
        + updateBotBoardHp(boardHp: Integer[4])
        + updateBotBoardAtt(boardAtt: Integer[4])
        + updateBotBoardModif(boardModif: String[4])
        + updateBotBoardName(boardName: String[4])
        + getBotWaitingBoardStatus(index: Integer) : Boolean
        + getBotWaitingBoardHp(index: Integer) : Integer
        + getBotWaitingBoardAtt(index: Integer) : Integer
        + getBotWaitingBoardModif(index: Integer) : String
        + getBotWaitingBoardName(index: Integer) : String
        + getBotBoardStatus(index: Integer) : Boolean
        + getBotBoardHp(index: Integer) : Integer
        + getBotBoardAtt(index: Integer) : Integer
        + getBotBoardModif(index: Integer) : String
        + getBotBoardName(index: Integer) : String
    }

    class GeneralView {
        - m_gameObserver : GameTextObserver
        - m_playerObserver : PlayerTextObserver
        - m_botObserver : BotTextObserver
        - m_scanner : Scanner
        + GeneralView(game: GameTextObserver, player: PlayerTextObserver, bot: BotTextObserver)
        + show()
        + gameStart() : Boolean
        + askForBlood(remainingSacrifice: Integer)
        + promptUser() : String
        + printGameInfo()
        + printBotWaitingBoard()
        + printBotBoard()
        + printPlayerBoard()
        + printPlayerHand()
        + printAction()
        + askNextGame()
        + askNewCard()
    }
}

package "controller" {

    class GameController {
        - m_game : Game
        - m_view : GeneralView
        + GameController(game: Game, view: GeneralView)
        + startGame()
        + verifPlacementIndex(input: String) : Boolean
        + verifBlood(input: String) : Boolean
        + verifBone(input: String) : Boolean
        + verifCardIndex(input: String) : Boolean
        + verifInputSize(input: String, wordCount: Integer) : Boolean
        + costBlood(input: String) : Boolean
        + costBone(input: String) : Boolean
        + getBloodCost(input: String) : Integer
        + getBoneCost(input: String) : Integer
        + placer(valid: Boolean, input: String) : Boolean
        + getNewCard() : String
    }
}

class Main {
    + {static} main(args: String[])
}

Card <|.. AliveCard
Card <|.. BaseCard
BaseCard <|-- AnimalCard
BaseCard <|-- ObjectCard
AliveCard <|.. AnimalCard

AliveCardFactory ..> AnimalCard : <<creates>>
AliveCardFactory ..> "models.cards.decorators" : <<uses>>
ObjectCardFactory ..> ObjectCard : <<creates>>

AliveCard <|.. AnimalDecorator
Card <|.. ObjectDecorator

AnimalDecorator <|-- AirborneAnimal
AnimalDecorator <|-- FledglingAnimal
AnimalDecorator <|-- ManyLivesAnimal
AnimalDecorator <|-- SharpQuillsAnimal
AnimalDecorator <|-- SprinterAnimal
AnimalDecorator <|-- StinkyAnimal
AnimalDecorator <|-- TouchOfDeathAnimal

AnimalDecorator o-- AliveCard : wraps

Playable <|.. Player
Playable <|.. Bot

Board <|-- Board

MatchStrategy <|.. FirstMatch
MatchStrategy <|.. SecondMatch
MatchStrategy <|.. ThirdMatch

Game "1" *--> "1" Combat
Game "1" *--> "1" Player
Game o--> MatchStrategy
Game o-->"1..*" GameObserver
Game o-->BotObserver

Combat "1" *-->"1" Player
Combat "1" *-->"1" Bot
Combat o-->MatchStrategy

Player "1" *-->"1" Board
Player o-->"1..*" PlayerObserver

Bot "1" *-->"2" Board
Bot o-->"0..*" BotObserver

FirstMatch ..> Bot : <<creates>>
FirstMatch ..> Board : <<creates>>
SecondMatch ..> Bot : <<creates>>
SecondMatch ..> Board : <<creates>>
ThirdMatch ..> Bot : <<creates>>
ThirdMatch ..> Board : <<creates>>

GameObserver <|.. GameTextObserver
PlayerObserver <|.. PlayerTextObserver
BotObserver <|.. BotTextObserver

GeneralView o-->GameTextObserver
GeneralView o-->PlayerTextObserver
GeneralView o-->BotTextObserver

GameController o-->Game
GameController o-->GeneralView

Main ..> GameController : <<creates>>
Main ..> Game : <<creates>>
Main ..> Player : <<creates>>
Main ..> GeneralView : <<creates>>

@enduml
