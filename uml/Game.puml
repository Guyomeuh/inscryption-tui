@startuml
'https://plantuml.com/class-diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

class Inscryption
{
    +Main (args : String[*])
}

package View
{
}
package Model
{
    package Gameplay
    {
        class Game
        {
            - m_player : Player
            +<<Create>> Game(strategy : MatchStrategy, player : Player)
            +setStrategy()
            +nextCombat()
            +beginCombat()
            +endTurn()
            +sacrifice(position : Integer)
            +place(position : Integer, numCarte : Integer)
            +draw(player : Player)
        }

        class Combat
        {
            - m_player : Player
            - m_bot : Bot
            - m_currentPlayer : Player
            - <<Static>> m_turn : Integer
            +<<Create>> Combat(bot : Player, player : Player)
            +draw()
            +place(position : Integer, numCarte : Integer)
            +sacrifice(position : Integer)
            +endTurn()
            +getTurn() : Integer
        }



        interface MatchStrategy
        {
            +initBot()
        }

        class FirstMatch implements MatchStrategy
        {
            +<<Create>> FirstMatch()
            +initBot()
        }

        class SecondMatch implements MatchStrategy
        {
            +<<Create>> SecondMatch()
            +initBot()
        }

        class ThirdMatch implements MatchStrategy
        {
            +<<Create>> ThirdMatch()
            +initBot()
        }

        Game "0..1" o--> "m_strategy" MatchStrategy  : > applies
        Game "0..1" *-l-> "m_combat" Combat :  \t\t\t
        Combat o--> Player
        Combat *-> Bot

        class PlayerBoard
        {
            -m_cards : Optional<Card>[4]
            +<<Create>> PlayerBoard()
            +isOccupied(position : Integer) : Boolean
            +set(position : Integer)
            +remove(position : Integer)

        }

        class Player
        {
            - {static} <<final>> BASE_CARD_NUMBER: Integer
            - m_deck: AliveCard[*] 
            - m_hand: AliveCard[*]
            - m_board : PlayerBoard

            + <<Creates>> Player(deck: AliveCard[*], board: Playerboard)

            - initHand()
            + draw()
            + getDeckSize(): Integer
            + getHandSize(): Integer

            + toString(): String
        }

        class Bot extends Player
        {
        }
    }

}

package Controller
{
    package GameplayController
    {
        class GameController
        {
            + <<Create>> GameController(game : Game)
            + startGame()
            + endTurn()
            + draw()
            + sacrifice()
            + place()
            + quit()
        }
    }
}

GameController "1" *.> "1\n-m_game" Game : > controls\t\t\t\t\t\t\t\t
Player o--> PlayerBoard

@enduml
