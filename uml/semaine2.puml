@startuml

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

skinparam nodesep 30
skinparam ranksep 40
skinparam padding 2

class Inscryption
{
    +Main (args : String[*])
}

package models {
    package observer {
        interface BotObserver <<interface>> {
            +updateBotWaitingBoardStatus(nextBoardStatus: Boolean[4])
            +updateBotWaitingBoardHp(nextBoardHp: Integer[4])
            +updateBotWaitingBoardAtt(nextBoardAtt: Integer[4])
            +updateBotWaitingBoardModif(nextBoardModif: String[4])
            +updateBotWaitingBoardName(nextBoardName: String[4])
            +updateBotBoardStatus(boardStatus: Boolean[4])
            +updateBotBoardHp(boardHp: Integer[4])
            +updateBotBoardAtt(boardAtt: Integer[4])
            +updateBotBoardModif(boardModif: String[4])
            +updateBotBoardName(boardName: String[4])

            +getBotWaitingBoardStatus(index: Integer): Boolean
            +getBotWaitingBoardHp(index: Integer): Integer
            +getBotWaitingBoardAtt(index: Integer): Integer
            +getBotWaitingBoardModif(index: Integer): String
            +getBotWaitingBoardName(index: Integer): String
            +getBotBoardStatus(index: Integer): Boolean
            +getBotBoardHp(index: Integer): Integer
            +getBotBoardAtt(index: Integer): Integer
            +getBotBoardModif(index: Integer): String
            +getBotBoardName(index: Integer): String
        }

        interface GameObserver <<interface>> {
            +updateTurn(turnNumber: Integer)
            +updateBalance(balance: Integer)
            +updateGameNumber(gameNumber: Integer)
        }

        interface PlayerObserver <<interface>> {
            +updatePlayerDeckCount(cardsAmount: Integer)
            +updatePlayerHand(hand: String[4])
            +updatePlayerBoardStatus(boardStatus: Boolean[4])
            +updatePlayerBoardHp(boardHp: Integer[4])
            +updatePlayerBoardAtt(boardAtt: Integer[4])
            +updatePlayerBoardModif(boardModif: String[4])
            +updatePlayerBoardName(boardName: String[4])

            +getPlayerBoardStatus(index: Integer): Boolean
            +getPlayerBoardHp(index: Integer): Integer
            +getPlayerBoardAtt(index: Integer): Integer
            +getPlayerBoardModif(index: Integer): String
            +getPlayerHandCard(index: Integer): String
            +getPlayerDeckCount(): Integer
            +getPlayerBoardName(index: Integer): String
            +getPlayerHandSize(): Integer
        }
    }

    package cards {
        interface Card <<interface>> {
            + getName(): String
            + getHp(): Integer
            + getDamaged(damages: Integer)
            + getModif(): String
        }

        interface AliveCard <<interface>> implements Card {
            + getBlood(): Integer
            + getBone(): Integer
            + getAttack(): Integer
            + attack(opponent: Card)
        }

        abstract class BaseCard <<abstract>> implements Card {
            - m_name: String 
            - m_hp: Integer 

            + <<Creates>> BaseCard(name: String, hp: Integer)

            + toString(): String
        }

        class ObjectCard extends BaseCard {
            + <<Creates>> ObjectCard(name: String, hp: Integer)

            + toString(): String
        }

        class AnimalCard extends BaseCard implements AliveCard {
            - m_attack: Integer 
            - m_blood: Integer
            - m_bone: Integer

            + <<Creates>> AnimalCard(name: String, hp: Integer, attack: Integer, blood: Integer, bone: Integer)

            + toString(): String
        }

        package decorators {
            abstract class ObjectDecorator <<abstract>> implements models.cards.Card {
                - m_card: Card 
                - m_modif: String

                + <<Creates>> ObjectDecorator(card: Card, modif: String)

                + getName(): String

                + toString(): String
            }

            abstract class AnimalDecorator <<abstract>> implements models.cards.AliveCard {
                - m_card: AliveCard 
                - m_modif: String

                + <<Creates>> AnimalDecorator(card: AliveCard: modif: String)

                + getName(): String

                + toString(): String
            }
        }
    }

    package gameplay {
        abstract class Playable <<abstract>> {
            + {static} <<final>> BASE_CARD_NUMBER: Integer
            ~ m_board: PlayerBoard

            + <<Creates>> Playable(board: PlayerBoard)

            + endTurn(): Integer[4]
            + getDamaged(position: Integer, damages: Integer): Boolean
            + {abstract} <<abstract>> place(position: Integer, cardIndex: Integer): Boolean

            - toString(): String
        }

        class Player extends Playable {
            - m_bone: Integer
            - m_blood: Integer

            + <<Creates>> Player(deck: AliveCard[*], board: PlayerBoard, observer: PlayerObserver)

            - initHand()
            - validateHandIndex(int index)
            - validateDeckIndex(int index)
            + getBlood(): Integer
            + getBone(): Integer
            + sacrifice(position: Integer): Boolean
            + getDeckSize(): Integer
            + getHandSize(): Integer
            + draw(): Boolean

            + addObserver(observer: PlayerObserver)
            + updatePlayerDeckCount()
            + updatePlayerHand()
            + updatePlayerBoardStatus()
            + updatePlayerBoardHp()
            + updatePlayerBoardAtt()
            + updatePlayerBoardModif()
            + updatePlayerBoardName()

            + toString(): String
        }

        class Bot extends Playable {
            - m_waitingBoard: PlayerBoard

            + <<Creates>> Bot(board: PlayerBoard, waitingBoard: PlayerBoard, observer: BotObserver)

            + validateDeckIndex(index: Integer) 
            + getCardsSize(): Integer
            + transferCards()

            + addObserver(observer: BotObserver)
            + updateBotWaitingBoardStatus()
            + updateBotWaitingBoardHp()
            + updateBotWaintingBoardAtt()
            + updateBotWaitingBoardName()
            + updateBotWaitingBoardModif()
            + updateBotBoardStatus()
            + updateBotBoardHp()
            + updateBotBoardAtt()
            + updateBotBoardModif()
            + updateBotBoardName()

            + toString(): String
        }

        class PlayerBoard {
            # {static} <<final>> SIZE: Integer
            -m_cards : Card[4]

            +<<Create>> PlayerBoard()

            - validatePosition(int position)
            + isOccupied(position : Integer) : Boolean
            + set(position : Integer, Card card)
            + remove(position : Integer): Optional<Card>
            + sacrifice(position: Integer): Integer
            + getAttack(position: Integer): Integer
            + getHp(position: Integer): Integer
            + getModif(position: Integer): String
            + getName(position: Integer): String
            + getDamaged(position: Integer, damages: Integer): Boolean

            + toString(): String
        }

        class Game
        {
            - m_gameNumber: Integer

            +<<Create>> Game(strategy : MatchStrategy, player : Player, observer: GameObserver)

            +setStrategy()
            +nextCombat()
            +beginCombat()
            +endTurn()
            +sacrifice(position : Integer)
            +place(position : Integer, numCarte : Integer)
            +draw(player : Player)

            + addObserver(observer: GameObserver)
            + updateTurn()
            + updateBalance()
            + updateGameNumber()

            + toString(): String
        }

        class Combat
        {
            - {static} <<static>> m_turn : Integer
            - m_balance: Integer

            +<<Create>> Combat(bot : Player, player : Player)

            +draw(): Boolean
            +place(position : Integer, numCard : Integer): Boolean 
            +sacrifice(position : Integer)
            +endTurn(): Integer
            +getTurn() : Integer
            + checkVictory(): Integer
            + getBalance(): Integer

            + toString(): String
        }

        interface MatchStrategy <<interface>> {
            +initBot(): Bot
        }

        class FirstMatch implements MatchStrategy
        {
            +<<Create>> FirstMatch()

            +initBot(): Bot

            + toString(): String
        }

        class SecondMatch implements MatchStrategy
        {
            +<<Create>> SecondMatch()

            +initBot(): Bot

            + toString(): String
        }

        class ThirdMatch implements MatchStrategy
        {
            +<<Create>> ThirdMatch()

            +initBot(): Bot

            + toString(): String
        }
    }
} 

package view {
    class BotTextObserver implements models.observer.BotObserver {
        - m_waitingBoardStatus: Boolean[4]
        - m_waitingBoardHp: Integer[4]
        - m_waitingBoardAtt: Integer[4]
        - m_waitingBoardModif: String[4]
        - m_waitingBoardName: String[4]
        - m_boardStatus: Boolean[4]
        - m_boardHp: Integer[4]
        - m_boardAtt: Integer[4]
        - m_boardModif: String[4]
        - m_boardName: String[4]

        + <<Creates>> BotTextObserver()

        +toString(): String
    }

    class GameTextObserver implements models.observer.GameObserver {
        - m_turn: Integer
        - m_balance: Integer
        - m_gameNumber: Integer

        + <<Creates>> GameTextObserver()

        + getGameNumber(): String 
        + getBalance(): String
        + getTurn(): String

        + toString(): String 
    }

    class PlayerTextObserver implements models.observer.PlayerObserver {
        - m_deckCardAmount: Integer
        - m_playerHand: String[*];
        - m_playerBoardStatus: Boolean[4]
        - m_playerBoardHp: Integer[4]
        - m_playerBoardAtt: Integer[4]
        - m_playerBoardModif: String[4]
        - m_playerBoardName: String[4]

        + <<Creates>> PlayerTextObserver()

        + toString(): String
    }

    class GeneralView {
        - {final} m_gameObserver: GameTextObserver
        - {final} m_playerObserver: PlayerTextObserver;
        - {final} m_botObserver: BotTextObserver;

        + <<Creates>> GeneralView(game: GameTextObserver, player: PlayerTextObserver, bot: BotTextObserver)
        
        + show()
        + printGameInfo()
        + printBotWaitingBoard()
        + printBotBoard()
        + printPlayerBoard()
        + printPlayerHand()
        + printAction()

        + toString(): String
    }
}

package controller {
    package gameplay
    {
        class GameController
        {
            + <<Create>> GameController(game : Game)
            + startGame()
            + endTurn()
            + draw()
            + sacrifice()
            + place()
            + quit()
        }
    }

}

models.cards.decorators.ObjectDecorator "1"o-U->"1\n-m_Card" models.cards.Card: holds >

models.cards.decorators.AnimalDecorator "1"o-->"1\n-m_Card" models.cards.AliveCard: holds >


models.gameplay.Player "1"o-->"\t\t\t*\n-m_deck" models.cards.AliveCard: holds >
models.gameplay.Player "1"*-->"\t*\n-m_hand" models.cards.AliveCard: holds >
models.gameplay.Player "1"o-->"1\n-m_board" models.gameplay.PlayerBoard: holds >
models.gameplay.Player "1"*-->"*\n-m_observer" models.observer.PlayerObserver

models.gameplay.Bot "1"o-->"1\n-m_board" models.gameplay.PlayerBoard: holds >
models.gameplay.Bot "1"o-->"1\n-m_waitingBoard" models.gameplay.PlayerBoard: holds >
models.gameplay.Bot "1"o-->"*\n-m_cards" models.cards.AliveCard: holds >
models.gameplay.Bot "1"*-->"*\n-m_observer" models.observer.BotObserver

models.gameplay.Game "1" o--> "1\n-m_strategy" models.gameplay.MatchStrategy  : > applies
models.gameplay.Game "1" *-l--> "1\n-m_combat" models.gameplay.Combat  
models.gameplay.Game "1" o--> "1\n-m_player" models.gameplay.Player  
models.gameplay.Game "1"*-->"*\n-m_observer" models.observer.GameObserver

models.gameplay.Combat "1"o-->"1\n-m_player" models.gameplay.Player
models.gameplay.Combat "1"o-->"1\n-m_bot" models.gameplay.Bot
models.gameplay.Combat "1"*-->"1\n-m_currentPlayer" models.gameplay.Playable


view.GeneralView "1"o-->"1\n-{final}-m_playerObserver" view.PlayerTextObserver
view.GeneralView "1"o-->"1\n-{final}-m_botObserver" view.BotTextObserver
view.GeneralView "1"o-->"1\n-{final}-m_gameObserver" view.GameTextObserver


controller.gameplay.GameController "1" *.> "1\n-m_game" models.gameplay.Game : > controls\t\t\t\t\t\t\t\t

@enduml
